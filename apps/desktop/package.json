{
  "name": "@nighttime-ninja/desktop",
  "version": "0.7.2",
  "private": true,
  "description": "Nighttime Ninja desktop app",
  "author": "Nighttime Ninja contributors",
  "license": "MIT",
  "repository": "github:Spacegoose02/Nighttime-Ninja",
  "main": "main.cjs",
  "scripts": {
    "copy-launcher": "node -e \"require('fs').cpSync('../launcher','launcher',{recursive:true})\"",
    "start": "npm run copy-launcher && electron .",
    "dist": "npm run copy-launcher && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run copy-launcher && electron-builder --linux AppImage --publish never",
    "dist:mac": "npm run copy-launcher && electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.nighttimeninja.desktop",
    "productName": "Nighttime Ninja",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "launcher/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NighttimeNinja-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NighttimeNinja-Portable-${version}.${ext}"
    },
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "mac": {
      "category": "public.app-category.lifestyle",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Spacegoose02",
        "repo": "Nighttime-Ninja"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
