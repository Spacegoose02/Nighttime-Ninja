# Copy to .env and fill in. Never commit your real .env.

# Port the server listens on when run without Docker. In Docker, change the published port in docker-compose.yml instead.
# PORT=8080

# Public URL people use to reach the server (used for Google sign-in redirects and calendar links)
PUBLIC_URL=http://localhost:8080

# Your time zone, e.g. America/Chicago. Reminders go out at 9 am and 5 pm in this zone.
TZ=UTC

# Where the SQLite database and uploaded photos live when run without Docker. Docker always uses /data (the volume).
# DATA_DIR=./data

# Long random string used to sign cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Google sign-in (OIDC). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who can create an account: invite (needs a home join code, the default), open, or closed.
# The very first account can always be created and becomes the admin. Admins can change this in Settings.
SIGNUP_MODE=invite

# Name-only "quick sign-in": lan (home network addresses only, the default without Google), off, or anywhere.
# Never use "anywhere" on a server that's reachable from the internet.
LOCAL_LOGIN=

# Reverse proxies whose X-Forwarded-* headers are trusted. Defaults to loopback + private networks.
TRUST_PROXY=

# Optional: Kroger public API for live prices and deals (https://developer.kroger.com)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Optional: Claude API key for the Mixologist tab's chat and drink ideas (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: which Claude model to use (defaults to claude-opus-5-5)
ANTHROPIC_MODEL=
# Optional: how many AI requests (Gordy, Rocco, Idea Zone) one person can send per hour. 0 turns the cap off. Default 30.
AI_MESSAGES_PER_HOUR=

# Recipe import and feeds refuse links that point into your home network. Set to true if you import from your own LAN servers.
ALLOW_PRIVATE_FETCH=
