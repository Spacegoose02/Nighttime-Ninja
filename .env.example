# Copy to .env and fill in. Never commit your real .env.

# Port the server listens on
PORT=8080

# Public URL people use to reach the server (used for Google sign-in redirects and calendar links)
PUBLIC_URL=http://localhost:8080

# Where the SQLite database and uploaded photos live
DATA_DIR=./data

# Long random string used to sign cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Google sign-in (OIDC). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Allow name-only local sign-in (handy on a trusted home network, or before Google is set up).
# Defaults to true when Google sign-in is not configured.
ALLOW_LOCAL_LOGIN=

# Optional: Kroger public API for live prices and deals (https://developer.kroger.com)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
